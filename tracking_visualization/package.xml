<?xml version="1.0"?>
<package format="2">
  <name>tracking_visualization</name>
  <version>2.0.0</version>
  <description>The package for visualizing trajectories from a stream of pose or odometry messages</description>

  <author email="r-baran@hotmail.fr">Robin Baran</author>
  <maintainer email="r-baran@hotmail.fr">Robin Baran</maintainer>

  <license>MIT</license>

  <url type="website">https://github.com/RBinsonB/trajectory_visualization.git</url>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>python3-setuptools</exec_depend>
  <!--<exec_depend>mocap_qualisys</exec_depend>-->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
